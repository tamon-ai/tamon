# === Required ===
DISCORD_BOT_TOKEN=

# === Claude Code ===
CLAUDE_MODEL=claude-sonnet-4-20250514
TAMON_MAX_CONCURRENT=2
CLAUDE_MAX_EXECUTION_MINUTES=60

# === Notion (optional) ===
NOTION_API_KEY=
NOTION_DATABASES=tasks:your-tasks-db-id,knowledge:your-knowledge-db-id

# === Webhook Server (optional) ===
WEBHOOK_PORT=3456
WEBHOOK_AUTH_TOKEN=

# === Assistant ===
TAMON_NAME=TAMON
TZ=UTC
LOG_LEVEL=info

# === Channel Mapping (optional) ===
# Format: name:channel_id,name:channel_id
TAMON_CHANNELS=

# === Google Workspace (optional) ===
# Service Account (recommended for teams)
GOOGLE_SA_KEY_FILE=
GOOGLE_SA_IMPERSONATE_EMAIL=
# OAuth (fallback / single-user)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# === Slack (optional) ===
SLACK_BOT_TOKEN=
SLACK_USER_TOKEN=

# === Telegram (optional) ===
TELEGRAM_BOT_TOKEN=

# === Google Analytics 4 (optional) ===
GA4_PROPERTY_ID=

# === GitHub (optional) ===
GITHUB_TOKEN=

# === Vercel (optional) ===
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# === Linear (optional) ===
LINEAR_API_KEY=

# === Supabase (optional) ===
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_MANAGEMENT_TOKEN=

# === X / Twitter (optional) ===
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_BEARER_TOKEN=
